# =====================================================================
# LikenessLock monorepo — single root .gitignore.
# Do not add per-directory .gitignore files (contracts/, web/, etc.) —
# every rule for the whole repo lives here so there is one place to look.
# This repo publishes source only — see "Tooling & planning artifacts"
# below for everything deliberately kept out of the public repo.
# =====================================================================

# --- Secrets & environment files (never commit) -----------------------
# Matches .env, .env.local, contracts/.env, web/.env.local, etc. at any depth.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
RELAYER_PRIVATE_KEY*

# --- Scratch / debug / local-only test artifacts -----------------------
# One-off dry-run scripts and throwaway debug tests must never be committed.
scratch-*
**/scratch-*
Debug.t.sol
**/test/Debug.t.sol

# --- Tooling & planning artifacts (kept locally, not in the public repo) ---
# Agent/IDE tooling config, skill packages, and internal planning docs are
# how this was built, not what's being shipped — only product source goes
# in the public repo.
.claude/
.agents/
.aider-desk/
skills-lock.json
hackthon-details/*
*.docx
task.md
implementation_plan.md
USP_WINNING_SPECS.md
WINNING_SPEC.md

# --- Dependencies --------------------------------------------------------
node_modules/
**/node_modules/
pnpm-lock.yaml
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Foundry (contracts/) -------------------------------------------------
contracts/cache/
contracts/out/
contracts/broadcast/
# Vendored forge dependencies (forge-std, openzeppelin-contracts) — installed
# via `forge install`, not committed. Reproducible from foundry.toml remappings.
contracts/lib/

# --- Next.js (web/) --------------------------------------------------------
web/.next/
web/out/
web/build/
web/coverage/
web/.vercel/
web/*.tsbuildinfo
web/next-env.d.ts
web/.gitignore
# Auto-regenerated by `next dev` on every run (see generate-agent-files.js) —
# internal tooling scaffolding, not project documentation. Single README.md
# at the repo root is the one source of truth.
web/AGENTS.md
web/CLAUDE.md

# --- Generic build outputs -------------------------------------------------
dist/
build/
.next/
out/
.turbo/
.vercel/
.cache/

# --- IDE & OS ----------------------------------------------------------
.DS_Store
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# --- Logs ----------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
